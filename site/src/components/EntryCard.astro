---
import Freshness from './Freshness.astro';
import { KIND_LABEL, ORIGIN_LABEL, formatDate, type Entry } from '../lib/catalog';

interface Props { entry: Entry }
const { entry } = Astro.props;
const d = entry.data;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const originBits = [ORIGIN_LABEL[d.origin] ?? d.origin];
if (d.provider) originBits.push(d.provider);
if (d.license) originBits.push(d.license);
originBits.push(KIND_LABEL[d.kind] ?? d.kind);

const trailing = d.pairs_with.length
  ? `搭配 ${d.pairs_with.join(' / ')}`
  : d.agents.length
    ? d.agents.join(' / ')
    : '';
---
<a class="entry-card" href={`${base}/entries/${d.name}`}>
  <div class="meta">
    <span class:list={['origin', { local: d.origin === 'local' }]}>{originBits.join(' · ')}</span>
    <Freshness date={d.evaluated_at} />
  </div>
  <h3>{d.title}</h3>
  <p>{d.summary}</p>
  <footer>
    <span class="mono">{d.evaluated_version} · {formatDate(d.evaluated_at)}</span>
    <span>{trailing}</span>
  </footer>
</a>
