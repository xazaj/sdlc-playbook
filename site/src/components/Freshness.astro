---
import { freshness } from '../lib/catalog';

interface Props { date: Date; boxed?: boolean; showDays?: boolean }
const { date, boxed = false, showDays = false } = Astro.props;
const { state, label, days } = freshness(date);
---
<span class:list={['freshness', { boxed }]} data-state={state}>
  <span class="dot"></span>{showDays ? `${days} 天` : label}
</span>
