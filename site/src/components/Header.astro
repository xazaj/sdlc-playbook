---
import { allArticles, allCategories, allEntries, allProjects, formatDate } from '../lib/catalog';
interface Props { current?: string }
const { current } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const categories = await allCategories();
const entries = await allEntries();
const updated = entries.length ? formatDate(entries[0]!.data.evaluated_at) : '—';
const articles = await allArticles();
const projects = await allProjects();
---
<header class="masthead">
  <div class="shell inner">
    <div class="identity">
      <a class="wordmark" href={`${base}/`}>SDLC Playbook</a>
      <span class="doc-meta t-meta">
        <span class="mono">{entries.length} 个条目</span>
        <span aria-hidden="true">·</span>
        <span class="mono">更新于 {updated}</span>
      </span>
    </div>
    <nav class="primary" aria-label="分类">
      {categories.map((c) => (
        <a href={`${base}/#${c.data.id}`} data-tab-link={c.data.id}>{c.data.title}</a>
      ))}
      {articles.length > 0 && <a href={`${base}/articles/`}>文章</a>}
      {projects.length > 0 && <a href={`${base}/projects/`}>项目</a>}
      <button class="search-trigger" type="button" id="search-open" aria-haspopup="dialog">
        搜索<kbd>⌘K</kbd>
      </button>
    </nav>
  </div>
</header>

<dialog class="search" id="search-dialog" aria-label="搜索条目">
  <input type="search" id="search-input" placeholder="搜索条目、来源或正文" autocomplete="off" aria-controls="search-results" />
  <div class="results" id="search-results" data-empty="输入关键词以搜索。↑ ↓ 移动，⏎ 打开；右侧「复制」直接拿走 prompt，Esc 关闭。"></div>
  <div class="copy-note" id="search-copy-note" role="status" hidden></div>
</dialog>

<script define:vars={{ endpoint: `${base}/search.json` }}>
  const dialog = document.getElementById('search-dialog');
  const input = document.getElementById('search-input');
  const list = document.getElementById('search-results');
  const trigger = document.getElementById('search-open');
  let index = null;
  let hits = [];
  let cursor = 0;

  const noteEl = document.getElementById('search-copy-note');
  let noteTimer = 0;
  function note(text) {
    if (!noteEl) return;
    noteEl.textContent = text;
    noteEl.hidden = false;
    clearTimeout(noteTimer);
    noteTimer = setTimeout(() => { noteEl.hidden = true; }, 1800);
  }

  async function load() {
    if (!index) index = await (await fetch(endpoint)).json();
    return index;
  }

  function paint() {
    list.textContent = '';
    hits.forEach((hit, i) => {
      // A row, not a listbox option: the row holds a real link and a real
      // button, which interactive children inside role=option would break.
      // The keyboard cursor is marked with aria-current on the link.
      const row = document.createElement('div');
      row.className = 'hit' + (i === cursor ? ' active' : '');
      const a = document.createElement('a');
      a.className = 'hit-main';
      a.href = hit.url;
      if (i === cursor) a.setAttribute('aria-current', 'true');
      const name = document.createElement('div');
      name.className = 'name';
      name.textContent = hit.title;
      const why = document.createElement('div');
      why.className = 'why';
      why.textContent = `${hit.category} · ${hit.kind} · ${hit.invoke} · ${hit.summary}`;
      a.append(name, why);
      const copy = document.createElement('button');
      copy.type = 'button';
      copy.className = 'hit-copy';
      copy.title = `复制${hit.invoke} prompt`;
      copy.textContent = '复制';
      copy.addEventListener('click', async (event) => {
        event.preventDefault();
        event.stopPropagation();
        if (!hit.prompt) return;
        await navigator.clipboard.writeText(hit.prompt);
        copy.textContent = '已复制';
        note(`已复制「${hit.title}」的${hit.invoke} prompt`);
        setTimeout(() => { copy.textContent = '复制'; }, 1600);
      });
      row.append(a, copy);
      list.append(row);
    });
    list.querySelector('a[aria-current="true"]')?.scrollIntoView({ block: 'nearest' });
  }

  async function run() {
    const q = input.value.trim().toLowerCase();
    if (!q) { hits = []; cursor = 0; paint(); return; }
    const data = await load();
    hits = data.filter((item) => item.haystack.includes(q)).slice(0, 12);
    cursor = 0;
    paint();
    // No hits is a different state from "nothing typed yet": say so in real
    // DOM, not the idle hint in the CSS ::after.
    if (!hits.length) {
      const p = document.createElement('p');
      p.className = 'no-hit';
      p.textContent = '没有匹配的条目。换个关键词，或按 Esc 关闭。';
      list.append(p);
    }
  }

  function open() {
    if (!dialog.open) dialog.showModal();
    input.focus();
    input.select();
    load();
  }

  trigger?.addEventListener('click', open);
  input?.addEventListener('input', run);

  document.addEventListener('keydown', (event) => {
    const typing = /^(INPUT|TEXTAREA|SELECT)$/.test(document.activeElement?.tagName ?? '');
    if ((event.key === 'k' && (event.metaKey || event.ctrlKey)) || (event.key === '/' && !typing)) {
      event.preventDefault();
      open();
    }
  });

  dialog?.addEventListener('keydown', (event) => {
    if (!hits.length) return;
    if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
      event.preventDefault();
      cursor = (cursor + (event.key === 'ArrowDown' ? 1 : hits.length - 1)) % hits.length;
      paint();
    } else if (event.key === 'Enter') {
      event.preventDefault();
      window.location.href = hits[cursor].url;
    }
  });

  dialog?.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
</script>
