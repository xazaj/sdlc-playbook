---
import State from './State.astro';
import { KIND_LABEL, formatDate, type Entry } from '../lib/catalog';

interface Props {
  entries: Entry[];
  caption: string;
}
const { entries, caption } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<div class="table-wrap">
  <table class="ledger">
    <caption class="visually-hidden">{caption}</caption>
    <colgroup>
      <col class="c-name" />
      <col class="c-kind" />
      <col class="c-eval" />
    </colgroup>
    <thead>
      <tr>
        <th scope="col">条目</th>
        <th scope="col">形态</th>
        <th scope="col" class="num">评估</th>
      </tr>
    </thead>
    <tbody>
      {entries.map((e) => (
        <tr data-kind={e.data.kind} data-category={e.data.category}>
          <td class="name">
            <a href={`${base}/entries/${e.data.name}`}>{e.data.title}</a>
            <span class="desc">{e.data.summary}</span>
          </td>
          <td class="meta">{KIND_LABEL[e.data.kind] ?? e.data.kind}</td>
          <td class="eval">
            <span class="num">{e.data.evaluated_version}</span>
            <span class="when"><span class="num">{formatDate(e.data.evaluated_at)}</span><State date={e.data.evaluated_at} /></span>
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
<p class="ledger-note">{caption}</p>
{entries.length === 0 && (
  <p class="empty">尚无已评估的条目。条目只有在实际用过并写下评估之后才会出现，不做占位。</p>
)}
