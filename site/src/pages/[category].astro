---
import type { GetStaticPaths } from 'astro';
import Base from '../layouts/Base.astro';
import Ledger from '../components/Ledger.astro';
import { allCategories, allEntries, countByKind, entriesOf, relatedTo, KIND_LABEL } from '../lib/catalog';

export const getStaticPaths = (async () => {
  const categories = await allCategories();
  return categories.map((category) => ({ params: { category: category.data.id }, props: { category } }));
}) satisfies GetStaticPaths;

const { category } = Astro.props;
const c = category.data;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const categories = await allCategories();
const all = await allEntries();
const mine = entriesOf(all, c.id);
const related = relatedTo(all, c.id);
const kinds = countByKind(mine);
const titleOf = new Map(categories.map((x) => [x.data.id, x.data.title]));
---
<Base title={c.title} description={c.tagline} current={c.id}>
  <section class="shell opening">
    <div class="measure-wide">
      <h1 class="t-page">{c.title}</h1>
      <p class="t-lede">{c.tagline}</p>
    </div>
  </section>


  <section class="shell section">
    {mine.length > 1 && (
      <div class="filters">
        <div class="filter-set">
          <span class="t-meta">形态</span>
          <button class="filter" type="button" data-value="" aria-pressed="true">全部<span class="count">{mine.length}</span></button>
          {kinds.map(({ kind, count }) => (
            <button class="filter" type="button" data-value={kind} aria-pressed="false">
              {KIND_LABEL[kind] ?? kind}<span class="count">{count}</span>
            </button>
          ))}
        </div>
      </div>
    )}
    <Ledger entries={mine} categories={categories} showCategory={false} caption={`${c.title}下已评估的全部条目。`} />
  </section>
  {c.decision ? (
    <section class="shell section chapter grid12">
      <div class="span-6 flow">
        <h2 class="t-sub">{c.decision.headline}</h2>
        <p class="secondary measure">{c.decision.intro}</p>
        <ol class="steps">
          {c.decision.steps.map((s) => (
            <li><span>{s.text}</span></li>
          ))}
        </ol>
        {c.decision.note && <p class="t-compact tertiary measure">{c.decision.note}</p>}
      </div>
      <div class="span-5 start-8 flow">
        <table class="compare">
          <caption class="t-meta" style="text-align: left; padding-bottom: 12px;">出现下列信号时改变默认选择</caption>
          <thead><tr><th scope="col">信号</th><th scope="col">改走</th></tr></thead>
          <tbody>
            {c.decision.signals.map((s) => (
              <tr><td class="secondary">{s.when}</td><td>{s.then}</td></tr>
            ))}
          </tbody>
        </table>
        {c.decision.pitfalls && <p class="t-compact tertiary">{c.decision.pitfalls}</p>}
        {c.decision.sourceHref && (
          <p class="t-compact"><a href={c.decision.sourceHref}>{c.decision.sourceLabel} ↗</a></p>
        )}
      </div>
    </section>
  ) : (
    <section class="shell section chapter">
      <p class="secondary measure">本分类的判断依据尚未写定。在此之前，下方条目按评估日期排列，适用性请自行判断。</p>
    </section>
  )}

  {related.length > 0 && (
    <section class="shell section chapter">
      <div class="section-head">
        <h2 class="t-sub">相关条目</h2>
        <p class="t-compact">一个条目只归属一个分类，避免同一份内容在两处各自漂移。下列条目与本分类相邻，主条目在别处。</p>
      </div>
      <div class="table-wrap">
        <table class="ledger">
          <thead><tr><th scope="col">条目</th><th scope="col">主分类</th><th scope="col">为何不在本分类</th></tr></thead>
          <tbody>
            {related.map((e) => (
              <tr>
                <td class="name"><a href={`${base}/entries/${e.data.name}`}>{e.data.title}</a></td>
                <td class="meta">{titleOf.get(e.data.category)}</td>
                <td class="meta" style="white-space: normal;">{e.data.summary}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}

  {c.moreSources && (
    <section class="shell section">
      <h2 class="t-sub">更多来源</h2>
      <p class="secondary measure" style="margin-top: 8px;">{c.moreSources}</p>
    </section>
  )}

  <script>
    const rows = Array.from(document.querySelectorAll<HTMLTableRowElement>('table.ledger tbody tr[data-kind]'));
    for (const button of document.querySelectorAll<HTMLButtonElement>('.filter')) {
      button.addEventListener('click', () => {
        const value = button.dataset.value ?? '';
        for (const peer of document.querySelectorAll<HTMLButtonElement>('.filter')) {
          peer.setAttribute('aria-pressed', String(peer === button));
        }
        for (const row of rows) row.hidden = Boolean(value) && row.dataset.kind !== value;
      });
    }
  </script>
</Base>
