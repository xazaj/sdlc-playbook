---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { allArticles, allEntries, formatDate, readingMinutes } from '../../lib/catalog';

export const getStaticPaths = (async () => {
  const articles = await allArticles();
  return articles.map((article) => ({ params: { id: article.data.name }, props: { article } }));
}) satisfies GetStaticPaths;

const { article } = Astro.props;
const d = article.data;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { Content } = await render(article);
const minutes = readingMinutes(article.body);
const host = new URL(d.source).host.replace(/^www\./, '');
const entries = d.related.length ? await allEntries() : [];
const related = entries.filter((e) => d.related.includes(e.data.name));
---
<Base title={d.title} description={d.summary}>
  <div class="progress" id="progress" aria-hidden="true"></div>

  <section class="shell opening">
    <div class="measure-wide">
      <p class="t-meta"><a href={`${base}/articles/`}>文章</a>{d.tags.length > 0 && ` · ${d.tags.join(' / ')}`}</p>
      <h1 class="t-page" style={`margin-top: 8px; view-transition-name: ${d.name};`}>{d.title}</h1>
      <p class="t-lede">{d.summary}</p>
      <p class="meta-line">
        <span class="mono">{formatDate(d.date)}</span>
        <span aria-hidden="true">·</span>
        <span class="mono">{minutes} 分钟</span>
        <span aria-hidden="true">·</span>
        <a href={d.source}>{host} ↗</a>
        {d.author && (<><span aria-hidden="true">·</span><span>{d.author}</span></>)}
      </p>
    </div>
  </section>

  <div class="shell"><hr class="rule-strong" /></div>
  <section class="shell section grid12">
    <article class="span-8 prose article-body">
      <Content />
      <footer class="source-card">
        <span class="label">来源</span>
        {d.author && <span class="who">{d.author}</span>}
        <a href={d.source}>{host} ↗</a>
        {d.translated && <span class="tag">中文全译</span>}
      </footer>
    </article>
    <aside class="span-3 start-10 rail">
      {related.length > 0 && (
        <div class="rail-block">
          <p class="t-meta">相关条目</p>
          <div class="byline" style="margin-top: 8px;">
            {related.map((e) => (<span class="badge"><a href={`${base}/entries/${e.data.name}/`}>{e.data.title}</a></span>))}
          </div>
        </div>
      )}
      <nav class="toc" id="toc" aria-label="本页小节"></nav>
    </aside>
  </section>

  <script>
    const toc = document.getElementById('toc');
    const headings = Array.from(document.querySelectorAll<HTMLHeadingElement>('.article-body h2'));
    headings.forEach((h, i) => {
      h.id = h.id || `a-${i + 1}`;
      const a = document.createElement('a');
      a.href = `#${h.id}`;
      a.textContent = h.textContent ?? '';
      toc?.append(a);
    });

    // Reading progress: a hairline under the header that fills with the page.
    // Scroll itself is the state change; there is no transition to disable.
    const bar = document.getElementById('progress');
    function paintProgress() {
      if (!bar) return;
      const doc = document.scrollingElement;
      if (!doc) return;
      const max = doc.scrollHeight - window.innerHeight;
      bar.style.width = max > 0 ? `${(doc.scrollTop / max) * 100}%` : '0%';
    }
    addEventListener('scroll', paintProgress, { passive: true });
    paintProgress();
  </script>
</Base>
