---
import Base from '../../layouts/Base.astro';
import { allArticles, formatDate, readingMinutes } from '../../lib/catalog';

const articles = await allArticles();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base
  title="文章"
  description="给人读的归档：判断的来龙去脉与方法论长文，蒸馏成文，来源可溯。"
>
  <section class="shell opening">
    <div class="measure-wide">
      <h1 class="t-page">文章</h1>
      <p class="t-lede">给人读的归档。外部材料与讨论蒸馏成文，来源可溯；不进 agent 上下文，也不参与触发。</p>
    </div>
  </section>

  <div class="shell"><hr class="rule-strong" /></div>

  <section class="shell section">
    <div class="archive">
      {articles.map((a) => (
        <a class="archive-row" href={`${base}/articles/${a.data.name}/`}>
          <div class="head">
            <span class="title">{a.data.title}</span>
            <span class="date mono">{formatDate(a.data.date)}</span>
          </div>
          <p class="desc">{a.data.summary}</p>
          <p class="meta-line-inline mono">{a.data.tags.join(' / ')} · {readingMinutes(a.body)} 分钟</p>
        </a>
      ))}
    </div>
  </section>
</Base>
