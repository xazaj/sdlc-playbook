---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import State from '../../components/State.astro';
import { allCategories, allEntries, formatDate, KIND_LABEL, ORIGIN_LABEL } from '../../lib/catalog';

export const getStaticPaths = (async () => {
  const entries = await allEntries();
  return entries.map((entry) => ({ params: { id: entry.data.name }, props: { entry } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const d = entry.data;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const categories = await allCategories();
const category = categories.find((c) => c.data.id === d.category)!;
const { Content } = await render(entry);

const facts = ([
  ['形态', KIND_LABEL[d.kind] ?? d.kind],
  ['来源', [ORIGIN_LABEL[d.origin], d.provider].filter(Boolean).join(' · ')],
  ['许可', d.license ?? ''],
  ['搭配', d.pairs_with.join(' / ')],
  ['已验证 agent', d.agents.join(' / ')],
  ['安装位置', d.install_path ?? ''],
  ['版本由谁管理', d.release_source ?? ''],
] as [string, string][]).filter(([, v]) => Boolean(v));
---
<Base title={d.title} description={d.summary} current={d.category}>
  <section class="shell opening">
    <div class="measure-wide">
      <p class="t-meta"><a href={`${base}/${d.category}`}>{category.data.title}</a></p>
      <h1 class="t-page" style="margin-top: 8px;">{d.title}</h1>
      <p class="t-lede">{d.summary}</p>
      <p class="byline">
        <span class="num">{d.evaluated_version}</span>
        <span aria-hidden="true">·</span>
        <span class="num">{formatDate(d.evaluated_at)}</span>
        <span aria-hidden="true">·</span>
        <State date={d.evaluated_at} />
        {facts.map(([, v]) => (<><span aria-hidden="true">·</span><span>{v}</span></>))}
        {d.upstream && (<><span aria-hidden="true">·</span><a href={d.upstream}>{new URL(d.upstream).host.replace(/^www\./, '')} ↗</a></>)}
      </p>
    </div>
  </section>

  <section class="shell section grid12">
    <article class="span-7 prose">
      <Content />
    </article>
    <aside class="span-4 start-9 rail">
      <nav class="toc" id="toc" aria-label="本页小节"></nav>
    </aside>
  </section>

  <script>
    // The right rail carries the page's structure so it stays useful past the fold.
    const toc = document.getElementById('toc');
    const headings = Array.from(document.querySelectorAll<HTMLHeadingElement>('.prose h2'));
    headings.forEach((h, i) => {
      h.id = h.id || `s-${i + 1}`;
      const a = document.createElement('a');
      a.href = `#${h.id}`;
      a.textContent = h.textContent ?? '';
      toc?.append(a);
    });

    const seen = new IntersectionObserver((records) => {
      for (const record of records) {
        if (!record.isIntersecting) continue;
        for (const link of toc?.querySelectorAll('a') ?? []) link.removeAttribute('aria-current');
        toc?.querySelector(`a[href="#${record.target.id}"]`)?.setAttribute('aria-current', 'true');
      }
    }, { rootMargin: '0px 0px -70% 0px' });
    for (const h of headings) seen.observe(h);

    // Fenced blocks become copyable: a prompt is meant to be taken, not read.
    for (const pre of document.querySelectorAll<HTMLPreElement>('.prose pre')) {
      const lang = pre.querySelector('code')?.className.match(/language-([\w-]+)/)?.[1] ?? 'text';
      const block = document.createElement('div');
      block.className = 'block';
      const head = document.createElement('div');
      head.className = 'block-head';
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'copy';
      button.textContent = lang === 'text' ? '复制 prompt' : '复制';
      head.append(button);
      pre.replaceWith(block);
      block.append(head, pre);

      button.addEventListener('click', async () => {
        await navigator.clipboard.writeText(pre.innerText);
        button.textContent = '已复制';
        button.dataset.copied = 'true';
        setTimeout(() => {
          button.textContent = '复制';
          delete button.dataset.copied;
        }, 1600);
      });
    }
  </script>
</Base>
