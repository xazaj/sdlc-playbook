---
import Base from '../layouts/Base.astro';
import Ledger from '../components/Ledger.astro';
import { allCategories, allEntries, countByKind, entriesOf, KIND_LABEL } from '../lib/catalog';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const categories = await allCategories();
const entries = await allEntries();
const kinds = countByKind(entries);
---
<Base
  title="SDLC Playbook"
  description="按开发时刻分类的 agent 资产目录：每个条目给出适用边界、评估版本与可直接粘贴的安装 prompt。"
>
  <section class="shell opening">
    <div class="measure-wide">
      <h1 class="t-page">手上这件事，现在该装哪个资产？</h1>
      <p class="t-lede">每条给出适用边界、评估所基于的版本，以及一段可直接粘贴进 agent 会话的安装 prompt。</p>
    </div>
  </section>

  <section class="shell section">
    <div class="filters">
      <div class="filter-set">
        <button class="filter" type="button" data-facet="category" data-value="" aria-pressed="true">全部<span class="count">{entries.length}</span></button>
        {categories.filter((c) => entriesOf(entries, c.data.id).length > 0).map((c) => (
          <button class="filter" type="button" data-facet="category" data-value={c.data.id} aria-pressed="false">
            {c.data.title}<span class="count">{entriesOf(entries, c.data.id).length}</span>
          </button>
        ))}
      </div>
      <div class="filter-set">
        {kinds.map(({ kind, count }) => (
          <button class="filter" type="button" data-facet="kind" data-value={kind} aria-pressed="false">
            {KIND_LABEL[kind] ?? kind}<span class="count">{count}</span>
          </button>
        ))}
      </div>
    </div>
    <Ledger
      entries={entries}
      caption="按评估日期排序，最近评估的在前。评估版本指本库评估所基于的版本，不是上游当前版本；状态按评估日期计算，超过 90 天标 †，超过 180 天标 ‡。"
    />
  </section>

  <section class="shell section chapter">
    <div class="section-head">
      <h2 class="t-sub">四个时刻</h2>
      <p class="t-meta">判断依据写在各分类页的开头。</p>
    </div>
    <div class="moments">
      {categories.map((c) => {
        const n = entriesOf(entries, c.data.id).length;
        return (
          <a class="moment" href={`${base}/${c.data.id}`} data-empty={n === 0 ? 'true' : undefined}>
            <span class="name">{c.data.title}</span><span class="n">{n === 0 ? '尚无条目' : `${n} 条`}</span>
            <span class="why"> — {c.data.tagline}</span>
          </a>
        );
      })}
    </div>
  </section>

  <script>
    const active = { category: '', kind: '' };
    const rows = Array.from(document.querySelectorAll<HTMLTableRowElement>('table.ledger tbody tr'));

    function apply() {
      for (const row of rows) {
        const okCat = !active.category || row.dataset.category === active.category;
        const okKind = !active.kind || row.dataset.kind === active.kind;
        row.hidden = !(okCat && okKind);
      }
    }

    for (const button of document.querySelectorAll<HTMLButtonElement>('.filter')) {
      button.addEventListener('click', () => {
        const facet = button.dataset.facet as 'category' | 'kind';
        const value = button.dataset.value ?? '';
        // A second click on an active facet clears it; nothing here is decorative.
        active[facet] = active[facet] === value ? '' : value;
        for (const peer of document.querySelectorAll<HTMLButtonElement>(`.filter[data-facet="${facet}"]`)) {
          peer.setAttribute('aria-pressed', String((peer.dataset.value ?? '') === active[facet]));
        }
        apply();
      });
    }
  </script>
</Base>
