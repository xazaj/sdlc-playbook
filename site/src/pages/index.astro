---
import Base from '../layouts/Base.astro';
import Ledger from '../components/Ledger.astro';
import { allCategories, allEntries, countByKind, entriesOf, KIND_LABEL } from '../lib/catalog';

const categories = await allCategories();
const entries = await allEntries();
const kinds = countByKind(entries);
const CN_NUM = ['一', '二', '三', '四', '五', '六'];
const momentsLabel = `${CN_NUM[categories.length - 1] ?? categories.length}个时刻`;
---
<Base
  title="SDLC Playbook"
  description="按开发时刻分类的 agent 资产清单：每个条目给出适用边界、评估版本与可直接粘贴的安装 prompt。"
>
  <section class="shell opening">
    <div class="measure-wide">
      <h1 class="t-page">手上这件事，现在该装哪个资产？</h1>
      <p class="t-lede">每条给出适用边界、评估所基于的版本，以及一段可直接粘贴进 agent 会话的安装 prompt。</p>
    </div>
  </section>

  <div class="shell"><hr class="rule-strong" /></div>

  <section class="shell section">
    <div class="filters">
      <div class="filter-set" role="group" aria-label="按时刻筛选">
        <span class="t-meta">时刻</span>
        <button class="filter" type="button" data-tab="" aria-pressed="true">全部<span class="count">{entries.length}</span></button>
        {categories.map((c) => (
          <button class="filter" type="button" data-tab={c.data.id} aria-pressed="false">
            {c.data.title}<span class="count">{entriesOf(entries, c.data.id).length}</span>
          </button>
        ))}
      </div>
      <div class="filter-set" role="group" aria-label="按形态筛选">
        <span class="t-meta">形态</span>
        {kinds.map(({ kind, count }) => (
          <button class="filter" type="button" data-kind={kind} aria-pressed="false">
            {KIND_LABEL[kind] ?? kind}<span class="count">{count}</span>
          </button>
        ))}
      </div>
    </div>

    <Ledger
      entries={entries}
      caption="按评估日期排序，最近评估的在前。评估版本指本库评估所基于的版本，不是上游当前版本；状态按评估日期计算，超过 90 天标 †，超过 180 天标 ‡。"
    />
  </section>

  {categories.filter((c) => c.data.decision).map((c) => {
    const d = c.data.decision!;
    return (
      <section class="shell section chapter grid12" data-panel={c.data.id} hidden>
        <hr class="chapter-rule" />
        <div class="span-6 flow">
          <h2 class="t-sub">{d.headline}</h2>
          <p class="secondary measure">{d.intro}</p>
          <ol class="steps">
            {d.steps.map((s) => <li><span>{s.text}</span></li>)}
          </ol>
          {d.note && <p class="t-compact tertiary measure">{d.note}</p>}
        </div>
        <div class="span-5 start-8 flow">
          <table class="compare">
            <caption class="t-meta" style="text-align: left; padding-bottom: 12px;">出现下列信号时改变默认选择</caption>
            <thead><tr><th scope="col">信号</th><th scope="col">改走</th></tr></thead>
            <tbody>
              {d.signals.map((s) => <tr><td class="secondary">{s.when}</td><td>{s.then}</td></tr>)}
            </tbody>
          </table>
          {d.pitfalls && <p class="t-compact tertiary">{d.pitfalls}</p>}
          {d.sourceHref && <p class="t-compact"><a href={d.sourceHref}>{d.sourceLabel} ↗</a></p>}
        </div>
      </section>
    );
  })}

  <section class="shell section chapter">
    <h2 class="t-meta legend-label">{momentsLabel}</h2>
    <div class="legend">
      {categories.map((c) => (
        <button class="legend-row" type="button" data-tab={c.data.id} aria-pressed="false">
          <span class="k">{c.data.title}</span>
          <span class="v">{c.data.tagline.split('。')[0]}。</span>
        </button>
      ))}
    </div>
  </section>

  <script>
    const state = { tab: '', kind: '' };
    const rows = Array.from(document.querySelectorAll<HTMLTableRowElement>('table.ledger tbody tr:not(.no-match)'));
    const noMatch = document.querySelector<HTMLTableRowElement>('table.ledger tr.no-match');
    const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-panel]'));
    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-tab]'));
    const kindButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-kind]'));

    function apply() {
      for (const row of rows) {
        const okTab = !state.tab || row.dataset.category === state.tab;
        const okKind = !state.kind || row.dataset.kind === state.kind;
        row.hidden = !(okTab && okKind);
      }
      if (noMatch) noMatch.hidden = rows.some((r) => !r.hidden);
      for (const panel of panels) panel.hidden = panel.dataset.panel !== state.tab;
      for (const tab of tabs) tab.setAttribute('aria-pressed', String((tab.dataset.tab ?? '') === state.tab));
      for (const button of kindButtons) button.setAttribute('aria-pressed', String(button.dataset.kind === state.kind));
      for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-tab-link]')) {
        if (link.dataset.tabLink === state.tab) link.setAttribute('aria-current', 'page');
        else link.removeAttribute('aria-current');
      }
    }

    for (const tab of tabs) {
      tab.addEventListener('click', () => {
        state.tab = tab.dataset.tab ?? '';
        history.replaceState(null, '', state.tab ? `#${state.tab}` : location.pathname);
        apply();
        if (tab.classList.contains('legend-row')) {
          document.querySelector('.filters')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    }
    // A second click on an active kind clears it; nothing here is decorative.
    for (const button of kindButtons) {
      button.addEventListener('click', () => {
        state.kind = state.kind === button.dataset.kind ? '' : (button.dataset.kind ?? '');
        apply();
      });
    }

    function fromHash() {
      const id = location.hash.replace('#', '');
      state.tab = tabs.some((t) => t.dataset.tab === id) ? id : '';
      apply();
    }
    window.addEventListener('hashchange', fromHash);
    fromHash();
  </script>
</Base>
