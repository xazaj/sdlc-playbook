---
import Base from '../layouts/Base.astro';
import Ledger from '../components/Ledger.astro';
import { allCategories, allEntries, countByKind, KIND_LABEL, KIND_NOTE } from '../lib/catalog';

const categories = await allCategories();
const entries = await allEntries();
const groups = countByKind(entries).map(({ kind }) => ({ kind, items: entries.filter((e) => e.data.kind === kind) }));
---
<Base title="按形态浏览" description="全部条目按交付形态分组：技能、DESIGN.md、组件库与文档。">
  <section class="shell grid12 opening">
    <div class="span-7">
      <h1 class="t-page">按形态浏览</h1>
      <p class="t-lede">形态决定怎么装，分类决定何时用。同一形态会散落在不同分类，因为它们服务于项目推进的不同时刻。本页只回答有哪些，判断依据在各分类页。</p>
    </div>
  </section>

  {groups.map((g) => (
    <section class="shell section">
      <div class="section-head">
        <h2 class="t-section">{KIND_LABEL[g.kind] ?? g.kind}</h2>
        <p class="t-compact">{KIND_NOTE[g.kind]}</p>
      </div>
      <Ledger entries={g.items} categories={categories} showKind={false} caption={`形态为${KIND_LABEL[g.kind] ?? g.kind}的全部条目。`} />
    </section>
  ))}
</Base>
